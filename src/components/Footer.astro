
---
import "../styles/footer.css";
import logo from "../assets/image/logo.webp";
---

<footer class="footer-section" id="kontak">
  <div class="footer-container">

    <!-- GRID UTAMA 4 KOLOM -->
    <div class="footer-main">

      <!-- KOLOM 1: LOGO & DESKRIPSI -->
      <div class="footer-about">

        <a href="/" class="footer-brand">
          <span class="footer-logo">
            <img
              src={logo.src}
              alt="Logo Doa Baitullah"
              loading="lazy"
            />
          </span>

          <span class="footer-brand-name">
            <strong>Doa Baitullah</strong>
            <small>Sedekah Baitullah</small>
          </span>
        </a>

        <p class="footer-description">
          doabaitullah.com adalah platform penggalangan dana
          yang dikelola oleh Yayasan Alfatihah yang sudah
          berpengalaman dan terpercaya sejak 2016.
        </p>

      </div>

      <!-- KOLOM 2: KONTAK -->
      <div class="footer-contacts-column">

        <h3 class="footer-title">Kontak</h3>

        <div class="footer-contacts">

          <!-- ALAMAT -->
          <div class="footer-contact">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>

            <span>
              Jl. Ngablak Indah II No.24a,
              Bangetayu Kulon, Kec. Genuk,
              Kota Semarang, Jawa Tengah 50115
            </span>
          </div>

          <!-- EMAIL -->
          <a
            class="footer-contact"
            href="mailto:doabaitullah@alfatihah.com"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>

            <span>doabaitullah@alfatihah.com</span>
          </a>

          <!-- WHATSAPP -->
          <a
            class="footer-contact"
            href="https://wa.me/6285171171931"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5Z" />
              <path d="M9 9.5c.5 2.3 2.2 4 4.5 4.5" />
            </svg>

            <span>+62 851-7117-1931</span>
          </a>

        </div>

      </div>

      <!-- KOLOM 3: NAVIGASI -->
      <div class="footer-navigation">

        <h3 class="footer-title">Navigasi</h3>

        <nav aria-label="Navigasi footer">
          <a href="/#tentang">Tentang Kami</a>
          <a href="/#program">Program</a>
          <a href="/#testimoni">Testimoni</a>
          <a href="/#faq">FAQ</a>
          <a href="/#kontak">Kontak</a>
        </nav>

      </div>

      <!-- KOLOM 4: LEGALITAS -->
      <div class="footer-legal">

        <h3 class="footer-title">Legalitas</h3>

        <div class="footer-legal-list">

          <p class="footer-legal-item footer-legal-sk">
            <span class="footer-sk-line">
              Keputusan Menteri Hukum Dan Hak Asasi Manusia Republik Indonesia Nomor Administrasi
            </span>
            <span class="footer-sk-line">
              Hukum Umum-0004544.AH.01.04.Tahun 2023
            </span>
          </p>

          <p class="footer-legal-item">
            Nomor Pendaftaran Nazhir Lembaga
          </p>

          <p class="footer-legal-item">
            Izin Badan Wakaf Indonesia : 3.3.00420
          </p>

          <p class="footer-legal-item">
            Nomor Pokok Wajib Pajak : 40.959.478.5-518.000
          </p>

          <p class="footer-legal-item">
            Izin Pengumpulan Uang atau Barang :
            B/110/AR.02.06/X/2023
          </p>

          <p class="footer-legal-item">
            <strong>Izin Galang Dana:</strong>
            B/110/AR.02.06/X/2023
          </p>

          <p class="footer-legal-item">
            <strong>Nomor LKSS:</strong>
            99 /LKKS /VI /2023
          </p>

          <p class="footer-legal-item">
            <strong>Nomor Dinas STD:</strong>
            466.3/5076/2023
          </p>

        </div>

      </div>

    </div>

    <!-- GARIS PEMBATAS -->
    <div class="footer-divider"></div>

    <!-- COPYRIGHT -->
    <div class="footer-bottom">

      <p>
        © {new Date().getFullYear()} Doa Baitullah • Yayasan Alfatihah
      </p>

      <p class="footer-bottom-note">
        <span class="footer-dot"></span>
        Berbagi kebaikan, menebar kebermanfaatan.
      </p>

    </div>

  </div>
</footer>
