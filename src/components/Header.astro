---
import "../styles/header.css";

// IMPORT LOGO DARI FOLDER ASSETS
import logo from "../assets/image/logo.webp";
---

<header class="db-header">
  <div class="db-header-inner">

    <!-- LOGO + NAMA WEBSITE -->
    <a
      href="#beranda"
      class="db-brand"
      aria-label="Doa Baitullah - Beranda"
    >
      <!-- LOGO GAMBAR -->
      <img
        src={logo.src}
        alt="Logo Doa Baitullah"
        class="db-logo"
        width="60"
        height="60"
      />

      <!-- TULISAN DI SAMPING LOGO -->
      <div class="db-brand-text">
        <strong>Doa Baitullah</strong>
        <span>Sedekah Baitullah</span>
      </div>
    </a>

    <!-- NAVIGASI DESKTOP -->
    <nav class="db-nav" aria-label="Navigasi utama">
      <a href="#tentang">Tentang</a>
      <a href="#program">Program</a>
      <a href="#kontak">Kontak</a>
    </nav>

    <!-- TOMBOL KANAN -->
    <a href="#form-doa" class="db-cta">
      Titipkan Doa
    </a>

  </div>
</header>