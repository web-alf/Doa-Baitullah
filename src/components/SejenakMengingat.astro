
---
import background from "../assets/image/background.webp";
import "../styles/sejenak-mengingat.css";
---

<section
  class="sejenak-section"
  aria-labelledby="sejenak-heading"
  style={`--sejenak-bg: url('${background.src}')`}
>
  <div class="sejenak-overlay"></div>

  <div class="sejenak-container">
    <span class="sejenak-badge">
      SEJENAK MENGINGAT ALLAH
    </span>

    <h2 id="sejenak-heading" class="sejenak-heading">
      <span class="sejenak-heading-white">
        Meski kita belum bisa sampai ke Baitullah,
      </span>

      <span class="sejenak-heading-gold">
        Insya Allah doa dan harapan kita bisa
        lebih dulu disana.
      </span>
    </h2>

    <div class="sejenak-quote">
      <p>
        “Karena kita tidak pernah tahu doa mana yang
        Allah Ta’ala kabulkan, kapan waktunya dan
        melalui jalan apa.
      </p>

      <p>
        Tugas kita adalah berdoa, berikhtiar
        dan bertawakal”
      </p>
    </div>
  </div>
</section>
