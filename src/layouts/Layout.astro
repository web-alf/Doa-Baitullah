
---
import "../styles/gold-theme.css";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link rel="icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />

    <meta
      name="theme-color"
      content="#D4AF37"
    />

    <meta
      name="description"
      content="Titipkan doa dan harapan terbaikmu di Baitullah. Insya Allah doa akan diteruskan kepada santri yang mukim di Makkah untuk dipanjatkan di Masjidil Haram."
    />

    <title>Doa Baitullah | Titipkan Doa Terbaikmu</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;

    width: 100%;
    min-height: 100vh;

    overflow-x: hidden;

    background: #fdfaf5;
    color: #292929;

    font-family: Arial, Helvetica, sans-serif;
  }

  img {
    max-width: 100%;
  }

  button,
  input,
  textarea,
  select {
    font-family: inherit;
  }
</style>
