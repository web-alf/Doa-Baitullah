
---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import RuangDoa from "../components/RuangDoa.astro";
import JenisDoa from "../components/JenisDoa.astro";
import CaraMenitipkan from "../components/CaraMenitipkan.astro";
import FormDoa from "../components/FormDoa.astro";
import SejenakMengingat from "../components/SejenakMengingat.astro";
import Testimoni from "../components/Testimoni.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Doa Baitullah</title>

    <meta
      name="description"
      content="Titipkan doa dan harapan terbaikmu di Baitullah."
    />
  </head>

  <body>
    <!-- HEADER TANPA ANIMASI -->
    <Header />

    <main>
      <!-- HERO: BACKGROUND TETAP, KONTEN ANIMASI RINGAN -->
      <div class="hero-reveal">
        <Hero />
      </div>

      <!-- RUANG DOA -->
      <div class="scroll-reveal">
        <RuangDoa />
      </div>

      <!-- JENIS DOA -->
      <div class="scroll-reveal">
        <JenisDoa />
      </div>

      <!-- CARA MENITIPKAN -->
      <div class="scroll-reveal">
        <CaraMenitipkan />
      </div>

      <!-- FORM DOA -->
      <div class="scroll-reveal">
        <FormDoa />
      </div>

      <!-- SEJENAK MENGINGAT -->
      <div class="scroll-reveal">
        <SejenakMengingat />
      </div>

      <!-- TESTIMONI -->
      <div class="scroll-reveal">
        <Testimoni />
      </div>

      <!-- FAQ -->
      <div class="scroll-reveal">
        <FAQ />
      </div>

      <!-- CTA -->
      <div class="scroll-reveal">
        <CTA />
      </div>

      <!-- SECTION LAINNYA NANTI DI SINI -->
    </main>

    <!-- FOOTER TANPA ANIMASI -->
    <Footer />

    <!-- =====================================
         SCROLL REVEAL SCRIPT
    ===================================== -->
    <script>
      const revealElements =
        document.querySelectorAll<HTMLElement>(
          ".scroll-reveal, .hero-reveal"
        );

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (
        reducedMotion ||
        !("IntersectionObserver" in window)
      ) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const observer = new IntersectionObserver(
          (entries, observerInstance) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add(
                "is-visible"
              );

              // Animasi hanya satu kali
              observerInstance.unobserve(
                entry.target
              );
            });
          },
          {
            threshold: 0.05,
            rootMargin: "0px 0px -50px 0px",
          }
        );

        revealElements.forEach((element) => {
          observer.observe(element);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* =====================================
     GLOBAL RESET
  ===================================== */

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #fdfaf5;
  }

  /* =====================================
     MAIN
  ===================================== */

  main {
    padding-top: 80px;
  }

  /* =====================================
     HERO
     BACKGROUND TIDAK IKUT ANIMASI
  ===================================== */

  .hero-reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-reveal {
      opacity: 0;
      transform: translate3d(0, 25px, 0);

      transition:
        opacity 1.5s ease,
        transform 1.5s cubic-bezier(
          0.22,
          1,
          0.36,
          1
        );
    }

    .hero-reveal.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  /* =====================================
     SECTION SCROLL REVEAL
     SLOW + SMOOTH
  ===================================== */

  .scroll-reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-reveal {
      opacity: 0;
      transform: translate3d(0, 90px, 0);

      transition:
        opacity 1.8s cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
        transform 1.8s cubic-bezier(
          0.16,
          1,
          0.3,
          1
        );
    }

    .scroll-reveal.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  /* =====================================
     RESPONSIVE MOBILE
  ===================================== */

  @media (max-width: 768px) {
    html {
      scroll-padding-top: 130px;
    }

    main {
      padding-top: 120px;
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero-reveal {
        transform: translate3d(0, 15px, 0);
      }

      .hero-reveal.is-visible {
        transform: translate3d(0, 0, 0);
      }

      .scroll-reveal {
        transform: translate3d(0, 60px, 0);
        transition-duration: 1.6s;
      }

      .scroll-reveal.is-visible {
        transform: translate3d(0, 0, 0);
      }
    }
  }

  /* =====================================
     ACCESSIBILITY
  ===================================== */

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .hero-reveal,
    .scroll-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
